msgid "Groups"
msgstr "群组"

#: accounts/views.py:51
msgid "My Account"
msgstr "我的账户"

#: accounts/forms/auth.py:17
msgid "Domain name"
msgstr "域名"

#: accounts/forms/auth.py:18
msgid ""
"Enter the domain name to use, (ie. example.com). This will be used to query "
"for LDAP servers and to bind to the domain."
msgstr ""
"输入要使用的域名（例如 example.com）。这将用于查询 LDAP 服务器并绑定到该域。"

#: accounts/forms/auth.py:25 accounts/forms/auth.py:202 admin/forms.py:491
msgid "Use TLS for authentication"
msgstr "使用 TLS 进行认证"

#: accounts/forms/auth.py:29
msgid "Find DC from DNS"
msgstr "从 DNS 查找域控制器"

#: accounts/forms/auth.py:30
msgid "Query DNS to find which domain controller to use"
msgstr "查询 DNS 以确定要使用的域控制器"

#: accounts/forms/auth.py:34
msgid "Domain controller"
msgstr "域控制器"

#: accounts/forms/auth.py:35
msgid ""
"If not using DNS to find the DC, specify the domain controller(s) here (eg. "
"ctrl1.example.com ctrl2.example.com:389)"
msgstr ""
"如果不使用 DNS 查找域控制器，请在此指定域控制器（例如 ctrl1.example.com ctrl2.example.com:389）"

#: accounts/forms/auth.py:42
msgid "OU name"
msgstr "组织单位名称"

#: accounts/forms/auth.py:43
msgid "Optionally restrict users to specified OU."
msgstr "可选择将用户限制在指定的组织单位内。"

#: accounts/forms/auth.py:48
msgid "Group name"
msgstr "组名称"

#: accounts/forms/auth.py:49
msgid "Optionally restrict users to specified group."
msgstr "可选择将用户限制在指定的组内。"

#: accounts/forms/auth.py:54
msgid "Custom search root"
msgstr "自定义搜索根目录"

#: accounts/forms/auth.py:55
msgid ""
"Optionally specify a custom search root, overriding the built-in computed "
"search root. If set, \"OU name\" is ignored."
msgstr ""
"可选择指定一个自定义搜索根目录，覆盖内置计算的搜索根目录。如果设置了此选项，将忽略\"组织单位名称\"。"

#: accounts/forms/auth.py:62
msgid "Recursion Depth"
msgstr "递归深度"

#: accounts/forms/auth.py:63
msgid ""
"Depth to recurse when checking group membership. 0 to turn off, -1 for "
"unlimited."
msgstr ""
"检查组成员资格时的递归深度。0 表示关闭，-1 表示无限制。"

#: accounts/forms/auth.py:90
msgid "Active Directory Authentication Settings"
msgstr "Active Directory 认证设置"

#: accounts/forms/auth.py:95
msgid "Enable registration"
msgstr "启用注册"

#: accounts/forms/auth.py:96
msgid "Allow users to register new accounts."
msgstr "允许用户注册新账户。"

#: accounts/forms/auth.py:100
msgid "Show a captcha for registration"
msgstr "注册时显示验证码"

#: accounts/forms/auth.py:102
#, python-format
msgid ""
"Displays a captcha using <a href=\"%(recaptcha_url)s\">reCAPTCHA</a> on the "
"registration page. To enable this, you will need to go <a href="
"\"%(register_url)s\">here</A> to register an account and type in your new "
"keys below."
msgstr ""
"在注册页面使用 <a href=\"%(recaptcha_url)s\">reCAPTCHA</a> 显示验证码。要启用此功能，您需要前往 <a href=\"%(register_url)s\">这里</a> 注册一个账户，并在下方输入您的新密钥。"

#: accounts/forms/auth.py:114
msgid "reCAPTCHA Public Key"
msgstr "reCAPTCHA 公钥"

#: accounts/forms/auth.py:119
msgid "reCAPTCHA Private Key"
msgstr "reCAPTCHA 私钥"

#: accounts/forms/auth.py:128 accounts/forms/auth.py:137
msgid "This field is required."
msgstr "此为必填字段。"

#: accounts/forms/auth.py:142
msgid "Basic Authentication Settings"
msgstr "基本认证设置"

#: accounts/forms/auth.py:148
msgid "LDAP Server"
msgstr "LDAP 服务器"

#: accounts/forms/auth.py:149
msgid "The LDAP server to authenticate with. For example: ldap://localhost:389"
msgstr "用于认证的 LDAP 服务器。例如：ldap://localhost:389"

#: accounts/forms/auth.py:154
msgid "LDAP Base DN"
msgstr "LDAP 基础 DN"

#: accounts/forms/auth.py:155
msgid ""
"The LDAP Base DN for performing LDAP searches.  For example: ou=users,"
"dc=example,dc=com"
msgstr ""
"用于执行 LDAP 搜索的 LDAP 基础 DN。例如：ou=users,dc=example,dc=com"

#: accounts/forms/auth.py:161
msgid "Username Attribute"
msgstr "用户名属性"

#: accounts/forms/auth.py:162
msgid "The attribute in the LDAP server that stores a user's login name."
msgstr "LDAP 服务器中存储用户登录名的属性。"

#: accounts/forms/auth.py:167
msgid "Given Name Attribute"
msgstr "名字属性"

#: accounts/forms/auth.py:169
msgid "The attribute in the LDAP server that stores the user's given name."
msgstr "LDAP 服务器中存储用户名字的属性。"

#: accounts/forms/auth.py:174
msgid "Surname Attribute"
msgstr "姓氏属性"

#: accounts/forms/auth.py:176
msgid "The attribute in the LDAP server that stores the user's surname."
msgstr "LDAP 服务器中存储用户姓氏的属性。"

#: accounts/forms/auth.py:181
msgid "Full Name Attribute"
msgstr "全名属性"

#: accounts/forms/auth.py:182
msgid ""
"The attribute in the LDAP server that stores the user's full name.  This "
"takes precedence over the \"Given Name Attribute\" and \"Surname Attribute.\""
msgstr ""
"LDAP 服务器中存储用户全名的属性。此属性优先于\"名字属性\"和\"姓氏属性\"。"

#: accounts/forms/auth.py:188 accounts/forms/auth.py:285
msgid "E-Mail Domain"
msgstr "电子邮件域名"

#: accounts/forms/auth.py:189
msgid ""
"The domain name appended to the username to construct the user's e-mail "
"address. This takes precedence over \"E-Mail LDAP Attribute.\""
msgstr ""
"附加到用户名后面以构成用户电子邮件地址的域名。此设置优先于\"电子邮件 LDAP 属性\"。"

#: accounts/forms/auth.py:196
msgid "E-Mail LDAP Attribute"
msgstr "电子邮件 LDAP 属性"

#: accounts/forms/auth.py:197
msgid ""
"The attribute in the LDAP server that stores the user's e-mail address. For "
"example: mail"
msgstr "LDAP 服务器中存储用户电子邮件地址的属性。例如：mail"

#: accounts/forms/auth.py:206
msgid "Custom LDAP User Search Filter"
msgstr "自定义 LDAP 用户搜索过滤器"

#: accounts/forms/auth.py:207
#, python-format
msgid ""
"A custom LDAP search filter, corresponding to RFC 2254. If left unset, this "
"option is equivalent to <tt>(usernameattribute=%(varname)s)</tt>. Use <tt>"
"\"%(varname)s\"</tt> wherever the username would normally go. Specify this "
"value only if the default cannot locate all users."
msgstr ""
"一个自定义的 LDAP 搜索过滤器，符合 RFC 2254 标准。如果不设置，此选项等同于 <tt>(usernameattribute=%(varname)s)</tt>。在通常需要输入用户名的地方使用 <tt>\"%(varname)s\"</tt>。仅在默认设置无法定位所有用户时指定此值。"

#: accounts/forms/auth.py:218
msgid "Review Board LDAP Bind Account"
msgstr "Review Board LDAP 绑定账户"

#: accounts/forms/auth.py:219
msgid ""
"The full distinguished name of a user account with sufficient access to "
"perform lookups of users and groups in the LDAP server. If the LDAP server "
"permits such lookups via anonymous bind, you may leave this field blank."
msgstr ""
"具有足够权限在 LDAP 服务器中查找用户和组的用户账户的完整可分辨名称。如果 LDAP 服务器允许通过匿名绑定进行此类查找，则可以留空此域。"

#: accounts/forms/auth.py:228
msgid "Review Board LDAP Bind Password"
msgstr "Review Board LDAP 绑定密码"

#: accounts/forms/auth.py:230
msgid "The password for the Review Board LDAP Bind Account."
msgstr "Review Board LDAP 绑定账户的密码。"

#: accounts/forms/auth.py:255
msgid "LDAP Authentication Settings"
msgstr "LDAP 认证设置"

#: accounts/forms/auth.py:260
msgid "Backends"
msgstr "后端"

#: accounts/forms/auth.py:261
msgid ""
"A comma-separated list of old-style custom auth backends. These are "
"represented as Python module paths."
msgstr ""
"一个以逗号分隔的旧风格自定义认证后端列表。这些以 Python 模块路径表示。"

#: accounts/forms/auth.py:279
msgid "Legacy Authentication Module Settings"
msgstr "旧版认证模块设置"

#: accounts/forms/auth.py:289
msgid "NIS Authentication Settings"
msgstr "NIS 认证设置"

#: accounts/forms/auth.py:294
msgid "Username Field"
msgstr "用户名字段"

#: accounts/forms/auth.py:298
msgid "DN (Distinguished Name)"
msgstr "DN（可分辨名称）"

#: accounts/forms/auth.py:299
msgid "CN (Common Name)"
msgstr "CN（通用名称）"

#: accounts/forms/auth.py:300
msgid "Email address"
msgstr "电子邮件地址"

#: accounts/forms/auth.py:302
msgid ""
"The X.509 certificate field from which the Review Board username will be "
"extracted."
msgstr ""
"将从该 X.509 证书字段中提取 Review Board 用户名。"

#: accounts/forms/auth.py:307
msgid "Username Regex"
msgstr "用户名正则表达式"

#: accounts/forms/auth.py:308
msgid ""
"Optional regex used to convert the selected X.509 certificate field to a "
"usable Review Board username. For example, if using the email field to "
"retrieve the username, use this regex to get the username from an e-mail "
"address: '(\\s+)@yoursite.com'. There must be only one group in the regex."
msgstr ""
"可选的正则表达式，用于将所选的 X.509 证书字段转换为可用的 Review Board 用户名。例如，如果使用电子邮件字段来检索用户名，可以使用此正则表达式从电子邮件地址中获取用户名：'(\\s+)@yoursite.com'。正则表达式中必须只有一个组。"

#: accounts/forms/auth.py:318
msgid "Automatically create new user accounts."
msgstr "自动创建新用户账户"

#: accounts/forms/auth.py:319
msgid ""
"Enabling this option will cause new user accounts to be automatically "
"created when a new user with an X.509 certificate accesses Review Board."
msgstr ""
"启用此选项后，当持有 X.509 证书的新用户访问 Review Board 时，将自动创建新的用户账户。"

#: accounts/forms/auth.py:336
msgid "X.509 Client Certificate Authentication Settings"
msgstr "X.509 客户端证书认证设置"

#: accounts/forms/pages.py:33
msgid "Save Settings"
msgstr "保存设置"

#: accounts/forms/pages.py:36
msgid "Time zone"
msgstr "时区"

#: accounts/forms/pages.py:38
msgid "The time zone you're in."
msgstr "您所在的时区。"

#: accounts/forms/pages.py:41
msgid "Enable syntax highlighting in the diff viewer"
msgstr "在差异查看器中启用语法高亮显示"

#: accounts/forms/pages.py:44
msgid "Always open an issue when comment box opens"
msgstr "当评论框打开时始终创建一个问题"

#: accounts/forms/pages.py:74
msgid "Your settings have been saved."
msgstr "您的设置已保存。"

#: accounts/forms/pages.py:80 accounts/forms/pages.py:81
msgid "Change Password"
msgstr "更改密码"

#: accounts/forms/pages.py:84
msgid "Current password"
msgstr "当前密码"

#: accounts/forms/pages.py:88
#: templates/accounts/password_reset_confirm.html:16
msgid "New password"
msgstr "新密码"

#: accounts/forms/pages.py:92
msgid "New password (confirm)"
msgstr "新密码（确认）"

#: accounts/forms/pages.py:102
msgid "This password is incorrect"
msgstr "此密码不正确"

#: accounts/forms/pages.py:109
msgid "Passwords do not match"
msgstr "密码不匹配"

#: accounts/forms/pages.py:119
msgid "Your password has been changed."
msgstr "您的密码已更改。"

#: accounts/forms/pages.py:126
msgid "Save Profile"
msgstr "保存个人资料"

#: accounts/forms/pages.py:129
msgid "First name"
msgstr "名字"

#: accounts/forms/pages.py:132
msgid "Last name"
msgstr "姓氏"

#: accounts/forms/pages.py:135 templates/accounts/password_reset.html:24
msgid "E-mail address"
msgstr "电子邮件地址"

#: accounts/forms/pages.py:139
msgid "Keep profile information private"
msgstr "保持个人资料信息私密"

#: accounts/forms/pages.py:179
msgid "Your profile has been saved."
msgstr "您的个人资料已保存。"

#: accounts/forms/registration.py:60
msgid "The text you entered didn't match what was displayed"
msgstr "您输入的文本与显示的内容不匹配"

#: accounts/forms/registration.py:66
msgid "You need to respond to the captcha"
msgstr "您需要输入验证码"

#: admin/checks.py:228
#, python-format
msgid ""
"Pygments %(cur_version)s is installed, but %(required_version)s or higher is "
"required to use syntax highlighting."
msgstr ""
"已安装 Pygments %(cur_version)s 版本，但要使用语法高亮显示，需要安装 %(required_version)s 或更高版本。"

#: admin/checks.py:235
#, python-format
msgid ""
"Syntax highlighting requires the <a href=\"%(url)s\">Pygments</a> library, "
"which is not installed."
msgstr ""
"语法高亮显示需要 <a href=\"%(url)s\">Pygments</a> 库，但该库未安装。"

#: admin/checks.py:247
msgid ""
"LDAP authentication requires the python-ldap library, which is not installed."
msgstr "LDAP 认证需要 python-ldap 库，但该库未安装。"

#: admin/checks.py:261
msgid ""
"PyDNS, which is required to find the domain controller, is not installed."
msgstr "查找域控制器需要 PyDNS 库，但该库未安装。"

#: admin/checks.py:272
#, python-format
msgid "Amazon S3 backend failed to load: %s"
msgstr "Amazon S3 后端加载失败：%s"

#: admin/checks.py:275
msgid "Amazon S3 depends on django-storages, which is not installed"
msgstr "Amazon S3 依赖于 django-storages 库，但该库未安装。"

#: admin/checks.py:286
msgid "CouchDB depends on django-storages, which is not installed"
msgstr "CouchDB 依赖于 django-storages 库，但该库未安装。"

#: admin/forms.py:58
msgid "Memcached"
msgstr "Memcached 缓存"

#: admin/forms.py:59
msgid "File cache"
msgstr "文件缓存"

#: admin/forms.py:80
msgid "Server"
msgstr "服务器"

#: admin/forms.py:81
msgid ""
"The URL of this Review Board server. This should not contain the "
"subdirectory Review Board is installed in."
msgstr ""
"此 Review Board 服务器的 URL。该 URL 不应包含 Review Board 安装的子目录。"

#: admin/forms.py:86
msgid "Media URL"
msgstr "媒体文件 URL"

#: admin/forms.py:87
msgid ""
"The URL to the media files. Leave blank to use the default media path on "
"this server."
msgstr "媒体文件的 URL。留空则使用此服务器上的默认媒体路径。"

#: admin/forms.py:93
msgid "Administrator Name"
msgstr "管理员姓名"

#: admin/forms.py:97
msgid "Administrator E-Mail"
msgstr "管理员电子邮件"

#: admin/forms.py:102
msgid "Time Zone"
msgstr "时区"

#: admin/forms.py:104
msgid "The time zone used for all dates on this server."
msgstr "此服务器上所有日期使用的时区。"

#: admin/forms.py:107
msgid "Enable search"
msgstr "启用搜索功能"

#: admin/forms.py:108
msgid "Provides a search field for quickly searching through review requests."
msgstr "提供一个搜索字段，用于快速搜索审核请求。"

#: admin/forms.py:113
msgid "Max number of results"
msgstr "最大结果数"

#: admin/forms.py:114
msgid "Maximum number of search results to display."
msgstr "要显示的最大搜索结果数。"

#: admin/forms.py:119
msgid "Search results per page"
msgstr "每页搜索结果数"

#: admin/forms.py:120
msgid "Number of search results to show per page."
msgstr ""

#: admin/forms.py:125
msgid "Search index directory"
msgstr "搜索索引路径"

#: admin/forms.py:126
msgid "The directory that search index data should be stored in."
msgstr "存储搜索索引的目录"

#: admin/forms.py:132
msgid "Cache Backend"
msgstr "缓存后端"

#: admin/forms.py:134
msgid "The type of server-side caching to use."
msgstr "要使用的服务器端缓存类型"

#: admin/forms.py:138
msgid "Cache Path"
msgstr "缓存路径"

#: admin/forms.py:139
msgid "The file location for the cache."
msgstr "缓存的文件位置"

#: admin/forms.py:144
msgid "Cache Hosts"
msgstr "缓存主机"

#: admin/forms.py:145
msgid ""
"The host or hosts used for the cache, in hostname:port form. Multiple hosts "
"can be specified by separating them with a semicolon (;)."
msgstr "用于缓存的主机，格式为 hostname:port。多个主机可以用分号(;)分隔指定。"

#: admin/forms.py:152
msgid "Use Gravatar images"
msgstr "使用 Gravatar 头像"

#: admin/forms.py:153
msgid "Use gravatar.com for user avatars"
msgstr "使用 gravatar.com 作为用户头像"

#: admin/forms.py:173
msgid "Local memory cache"
msgstr "本地内存缓存"

#: admin/forms.py:178
msgid "Custom"
msgstr "自定义"

#: admin/forms.py:257
msgid "A valid cache host must be provided."
msgstr "必须提供有效的缓存主机"

#: admin/forms.py:266
msgid "A valid cache path must be provided."
msgstr "必须提供有效的缓存路径"

#: admin/forms.py:277
msgid "The search index path must be absolute."
msgstr "搜索索引路径必须是绝对路径"

#: admin/forms.py:282
msgid ""
"The search index path is not writable. Make sure the web server has write "
"access to it and its parent directory."
msgstr ""
"搜索索引路径无法写入。请确保网页服务器对其及其父目录具有写入权限。"

#: admin/forms.py:289
msgid "General Settings"
