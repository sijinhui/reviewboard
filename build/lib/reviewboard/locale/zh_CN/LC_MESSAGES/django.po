#: accounts/admin.py:16
msgid ""
"Required. 30 characters or fewer. Alphanumeric characters (letters, digits, "
"underscores, and periods) and '@'."
msgstr ""
"必填字段：30 个字符以内，可包含英文字母、数字、下划线符号（_）、破折号（-）和 "
"'@' 符号。"

#: accounts/admin.py:19
msgid ""
"This value must contain only letters, numbers, underscores, periods and '@'."
msgstr "这个字段只能填英文字母、数字、下划线符号（_）、破折号（-）和 '@' 符号。"

