msgstr "完成第一次设置"

#: accounts/models.py:52
msgid ""
"Indicates whether the user has already gone through the first time setup "
"process by saving their user preferences."
msgstr "指出用户是否已经完成首次设置并保存了他们的偏好设置"

#: accounts/models.py:58
msgid "collapsed diffs"
msgstr "折叠 diff 文件"

#: accounts/models.py:59
msgid ""
"Indicates whether diffs should be shown in their collapsed state by default."
msgstr "指出是否默认以折叠状态显示 diff 文件。"

#: accounts/models.py:63 reviews/models/review.py:95
msgid "This field is unused and will be removed in a future version."
msgstr "此字段未使用，将在未来版本中移除。"

